<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.pdrgds.pixma-bridge</string>
  <!-- Log to the user's own ~/Library/Logs rather than a shared, predictable
       path in /tmp. launchd doesn't expand ~ in StandardOutPath, so redirect
       via the shell instead. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>mkdir -p "$HOME/Library/Logs" &amp;&amp; exec /usr/local/bin/pixma-bridge &gt;&gt; "$HOME/Library/Logs/pixma-bridge.log" 2&gt;&amp;1</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
